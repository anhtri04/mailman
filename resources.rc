#include <windows.h>

#define IDI_APP_ICON 101

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

ID IDI_APP_ICON ICON "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Your Name or Organization"
            VALUE "FileDescription",  "Mailman - Terminal HTTP Client"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "mailman"
            VALUE "LegalCopyright",   "(c) 2024 Your Name"
            VALUE "OriginalFilename", "mailman-win-x64.exe"
            VALUE "ProductName",      "Mailman"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END