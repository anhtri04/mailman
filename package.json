{
  "name": "mailman",
  "version": "0.1.1",
  "private": true,
  "description": "A terminal-based HTTP client built with Bun and OpenTUI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run ./index.tsx",
    "start": "bun run ./index.tsx",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "seed": "bun run ./scripts/seed-collections.ts",
    "build:win": "bun build --compile ./index.tsx --outfile dist/mailman-win-x64.exe --target=bun-windows-x64",
    "build:linux": "bun build --compile ./index.tsx --outfile dist/mailman-linux-x64 --target=bun-linux-x64",
    "build:mac": "bun build --compile ./index.tsx --outfile dist/mailman-darwin-arm64 --target=bun-darwin-arm64"
  },
  "dependencies": {
    "@opentui/core": "^0.1.87",
    "@opentui/react": "^0.1.87",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.8",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
